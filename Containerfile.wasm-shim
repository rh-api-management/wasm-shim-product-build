# ------------------------------------------------------------------------------
# Build Stage
# ------------------------------------------------------------------------------

FROM registry.redhat.io/ubi9/ubi:latest as wasm-shim-build

ARG GITHUB_SHA
ENV GITHUB_SHA=${GITHUB_SHA:-unknown}
ARG TARGET=wasm32-wasip1
RUN PKGS="rust-toolset llvm-toolset gcc-c++ gcc-toolset-12-binutils-gold protobuf-devel protobuf-compiler openssl-devel perl git rust-std-static-${TARGET}" \
    && dnf install --nodocs --nobest --assumeyes $PKGS \
    && rpm --verify --nogroup --nouser $PKGS \
    && yum -y clean all

WORKDIR /usr/src/wasm-shim
RUN RUSTC_VERSION=$(rustc --version | awk '{print $2}') && \
    echo "Using Rust version: $RUSTC_VERSION"
COPY ./wasm-shim/Cargo.lock ./Cargo.lock
COPY ./wasm-shim/Cargo.toml ./Cargo.toml
COPY wasm-shim/.cargo/config.toml ./.cargo/config.toml

COPY ./wasm-shim/crates crates
COPY ./wasm-shim/vendor-protobufs vendor-protobufs

COPY wasm-shim/LICENSE /licenses/LICENSE

# UBI9/RHEL9 only ships protobuf-compiler 3.14.0, which rejects proto3 `optional`
# fields unless --experimental_allow_proto3_optional is passed (it became the
# default in protoc 3.15.0). The vendored protos use proto3 optional, so wrap
# protoc to always pass the flag and point prost-build at it via $PROTOC.
RUN printf '#!/bin/sh\nexec /usr/bin/protoc --experimental_allow_proto3_optional "$@"\n' > /usr/local/bin/protoc-wrapper \
    && chmod +x /usr/local/bin/protoc-wrapper
ENV PROTOC=/usr/local/bin/protoc-wrapper

RUN cargo build --target=wasm32-wasip1 --release --offline
USER 1001

# ------------------------------------------------------------------------------
# Run Stage
# ------------------------------------------------------------------------------
# Use the RHEL9 PQC variant of ubi-minimal, which ships with the system-wide
# crypto policy set to DEFAULT:PQ (CONNLINK-1566).
FROM registry.redhat.io/ubi9/ubi-minimal-pqc:latest
USER 1001
LABEL version="0.15.0" \
      com.redhat.component="wasm-shim-container" \
      name="rhcl-1/wasm-shim-rhel9" \
      cpe="cpe:/a:redhat:connectivity_link:1.5::el9" \
      summary="A Proxy-Wasm module written in Rust, acting as a shim between Envoy and Limitador." \
      description="A Proxy-Wasm module written in Rust, acting as a shim between Envoy and Limitador." \
      distribution-scope="public" \
      release="1.5.0" \
      url="https://catalog.redhat.com/software/containers/rhcl-1/wasm-shim-rhel9/672a1e565d865456f8f2835f" \
      vendor="Red Hat, Inc." \
      io.k8s.display-name="Wasm-shim" \
      io.k8s.description="A Proxy-Wasm module written in Rust, acting as a shim between Envoy and both Rate-limiting and External Auth services." \
      io.openshift.tags="rate limiting, envoy, api" \
      maintainer="eastizle@redhat.com"

COPY --from=wasm-shim-build /usr/src/wasm-shim/target/wasm32-wasip1/release/wasm_shim.wasm /plugin.wasm
COPY --from=wasm-shim-build licenses/LICENSE /licenses/LICENSE
